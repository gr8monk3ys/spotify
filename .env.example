# =============================================================================
# SpotifyForge Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All variables use the SPOTIFYFORGE_ prefix and map directly to the
# Settings class in spotifyforge/config.py. Unknown SPOTIFYFORGE_* keys are
# ignored, so a .env from an older version keeps working.

# -----------------------------------------------------------------------------
# Spotify OAuth credentials (required)
# Get these from https://developer.spotify.com/dashboard
# -----------------------------------------------------------------------------
SPOTIFYFORGE_SPOTIFY_CLIENT_ID=your_client_id_here
SPOTIFYFORGE_SPOTIFY_CLIENT_SECRET=your_client_secret_here
# Must match a redirect URI registered on the Spotify app. Nothing listens
# there: `auth login` asks you to paste the URL the browser lands on.
SPOTIFYFORGE_SPOTIFY_REDIRECT_URI=http://localhost:8000/api/auth/callback

# -----------------------------------------------------------------------------
# Local state
# -----------------------------------------------------------------------------
# Where the logged-in-user marker and the JSON sidecars live (tempo/key cache,
# stats history, pinned expansions, photo picks). Tokens are not here: they go
# to the OS keyring.
# SPOTIFYFORGE_DATA_DIR=~/.spotifyforge

# Shared directory `export library` writes music-library.json to, read by the
# discogs repo. The unprefixed MUSIC_DIR is honoured too.
# SPOTIFYFORGE_MUSIC_DIR=~/.music

# Where the letterboxd repo writes letterboxd.json, read by `library soundtracks`.
# The unprefixed MOVIES_DIR is honoured too.
# SPOTIFYFORGE_MOVIES_DIR=~/.movies

# -----------------------------------------------------------------------------
# Optional
# -----------------------------------------------------------------------------
# Logging level: DEBUG, INFO, WARNING, ERROR
SPOTIFYFORGE_LOG_LEVEL=INFO

# Pexels key for `curate covers --photos`; free from pexels.com/api.
# SPOTIFYFORGE_PEXELS_API_KEY=
